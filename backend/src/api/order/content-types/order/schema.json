{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "orderNumber": {
      "type": "string",
      "default": "ORD-00",
      "required": true,
      "unique": true
    },
    "orderDate": {
      "type": "datetime",
      "required": true
    },
    "deliveryDate": {
      "type": "datetime"
    },
    "order_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order-item.order-item",
      "mappedBy": "order"
    },
    "orderStatus": {
      "type": "string",
      "default": "pending",
      "required": true
    }
  }
}
